#!/usr/bin/env python3
import sys,json,os
with open('/tmp/fake-acp-start-log','a') as f:f.write(str(os.getpid())+'\n')
with open('/tmp/fake-acp-args-log','a') as f:f.write(json.dumps(sys.argv[1:])+'\n')
out=sys.stdout
if sys.argv[1:3]==['models','--json']:
 out.write(json.dumps({'models':[{'selector':'openai/gpt-5','name':'GPT-5','provider':'openai','thinking':['low','high']},{'selector':'xai/grok-4','name':'Grok 4','provider':'xai','thinking':['auto','max']}]})+'\n')
 sys.exit(0)
def send(v):
 out.write(json.dumps(v)+'\n');out.flush()
for line in sys.stdin:
 try:v=json.loads(line)
 except Exception:continue
 method=v.get('method')
 with open('/tmp/fake-acp-rpc-log','a') as f:f.write(json.dumps({'method':method,'params':v.get('params')})+'\n')
 if method=='initialize':
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{'authMethods':[],'agentCapabilities':{'mcpCapabilities':{'http':True}}}})
 elif method=='session/new':
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{'sessionId':'fake-omp-session','modes':{'availableModes':[],'currentModeId':''},'availableCommands':[{'name':'review','description':'Review code'},{'name':'test','description':'Run tests'}]}})
 elif method=='session/load':
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{'sessionId':v.get('params',{}).get('sessionId'),'modes':{'availableModes':[],'currentModeId':''}}})
 elif method=='session/set_mode':
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{}})
 elif method=='authenticate':
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{}})
 elif method=='session/prompt':
  with open('/tmp/fake-acp-prompt-log','a') as f:f.write(json.dumps(v.get('params',{}))+'\n')
  sid=v.get('params',{}).get('sessionId','')
  send({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':sid,'update':{'sessionUpdate':'usage_update','used':5000,'size':200000,'cost':{'amount':0.01,'currency':'USD'}}}})
  send({'jsonrpc':'2.0','method':'session/update','params':{'sessionId':sid,'update':{'sessionUpdate':'agent_message_chunk','content':{'type':'text','text':'acp done'}}}})
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{'stopReason':'end_turn'}})
 elif v.get('id') is not None:
  send({'jsonrpc':'2.0','id':v.get('id'),'result':{}})

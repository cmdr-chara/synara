{
  "schema": "rust-anything/app-cases@1",
  "name": "index",
  "run": [
    "bun",
    "run",
    "apps/server/src/index.ts",
    "--port",
    "{port}",
    "--host",
    "127.0.0.1",
    "--no-browser",
    "--home-dir",
    "./.rec-home",
    "--auth-token",
    "rectoken"
  ],
  "normalize": [
    "timestamps",
    "uuids"
  ],
  "normalizers": {
    "eventloop": "\"(sampleWindowMs|sampleCount|delayP50Ms|delayP99Ms|delayMaxMs|utilization|stallWindowCount|maxStallMs|discardedIdleGapCount|discardedIdleGapMs)\":[0-9.]+"
  },
  "timeout_secs": 60,
  "http": {}
}
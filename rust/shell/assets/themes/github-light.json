      "link_uri": {
        "color": "#005CC5"
      },
      "number": {
        "color": "#005CC5"
      },
      "operator": {
        "color": "#D73A49"
      },
      "preproc": {
        "color": "#D73A49"
      },
      "primary": {
        "color": "#24292E"
      },
      "property": {
        "color": "#24292E"
      },
      "punctuation": {
        "color": "#24292E"
      },
      "punctuation.bracket": {
        "color": "#24292E"
      },

#!/usr/bin/env python3
import sys,json
if sys.argv[1:]==['models']:
 print('x\tGemini 3.7 Flash (high)')
 sys.exit(0)
out=sys.stdout
current='gemini-flash'
def send(v): out.write(json.dumps(v)+'\n');out.flush()
def cfg():
 levels=['low','medium','high'] if current=='gemini-flash' else ['thinking']
 return [
  {'id':'model','name':'Model','category':'model','type':'select','currentValue':current,'options':[
   {'value':'gemini-flash','name':'Gemini 3.7 Flash'},
   {'value':'claude-sonnet','name':'Claude Sonnet 4.6'}
  ]},
  {'id':'thought_level','name':'Thinking','category':'thought_level','type':'select','currentValue':levels[-1],'options':[{'value':x,'name':x.title()} for x in levels]}
 ]
for line in sys.stdin:
 try:v=json.loads(line)
 except Exception:continue
 method=v.get('method'); rid=v.get('id')
 with open('/tmp/fake-agy-rpc-log','a') as f:f.write(json.dumps({'method':method,'params':v.get('params')})+'\n')
 if method=='initialize': send({'jsonrpc':'2.0','id':rid,'result':{'authMethods':[]}})
 elif method=='session/new': send({'jsonrpc':'2.0','id':rid,'result':{'sessionId':'fake-agy-session','configOptions':cfg()}})
 elif method=='session/set_config_option':
  p=v.get('params',{})
  if p.get('configId')=='model': current=p.get('value',current)
  send({'jsonrpc':'2.0','id':rid,'result':{'configOptions':cfg()}})
 elif rid is not None: send({'jsonrpc':'2.0','id':rid,'result':{}})

#!/usr/bin/env python3
"""Fake codex app-server supporting initialize, account/rateLimits/read and
account/rateLimitResetCredit/consume for reset-credit verification."""
import sys, json

def send(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        msg = json.loads(line)
    except json.JSONDecodeError:
        continue
    method = msg.get("method", "")
    mid = msg.get("id")
    if method == "initialize":
        send({"jsonrpc": "2.0", "id": mid, "result": {"serverInfo": {"name": "fake-codex"}}})
    elif method == "initialized":
        continue
    elif method == "account/rateLimits/read":
        send({"jsonrpc": "2.0", "id": mid, "result": {
            "accountId": "acct-test-1",
            "rateLimits": {
                "primary": {"usedPercent": 95, "resetsAt": 4102444800},
                "secondary": None,
                "limitId": "codex",
            },
        }})
    elif method == "account/rateLimitResetCredit/consume":
        key = msg.get("params", {}).get("idempotencyKey", "")
        outcome = "alreadyRedeemed" if key.endswith("again") else "reset"
        send({"jsonrpc": "2.0", "id": mid, "result": {"outcome": outcome}})
    elif mid is not None:
        send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "unknown method"}})

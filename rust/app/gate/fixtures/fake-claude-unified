#!/usr/bin/env python3
"""Unified fake claude CLI for the parity gate: `-p` invocations answer
text-generation prompts; anything else emulates the interactive stream-json
control plane used by thread turns."""
import sys, json, os

if "-p" in sys.argv or "--print" in sys.argv:
    prompt = sys.stdin.read()
    if "automation creation intents" in prompt:
        out = {
            "isAutomation": True,
            "confidence": 0.9,
            "language": "en",
            "name": "Daily follower count",
            "taskPrompt": "Update the follower count from the static file.",
            "schedule": {"type": "interval", "everySeconds": 86400},
            "mode": "heartbeat",
            "maxIterations": None,
            "completionPolicy": {"type": "none"},
            "missingFields": [],
            "needsConfirmation": False,
            "reason": None,
        }
    elif "predict the next message" in prompt:
        out = {"suggestion": "commit it and open a PR"}
    elif "engineering summaries for git diffs" in prompt:
        out = {"summary": "## Summary\n- Appends a line to a.txt and adds b.txt.\n\n## Files Changed\n- a.txt: appended content\n- b.txt: new file"}
    else:
        out = {"recap": "Ported browser download capture to the CDP backend; next up is usage snapshots verification."}
    send = {"type": "result", "result": json.dumps(out), "structured_output": out}
    sys.stdout.write(json.dumps(send) + "\n")

    sys.exit(0)

import sys,json,os
with open('/tmp/fake-claude-start-log','a') as f:f.write(str(os.getpid())+'\n')
with open('/tmp/fake-claude-args-log','a') as f:f.write(json.dumps(sys.argv[1:])+'\n')
out=sys.stdout
def send(v):
 out.write(json.dumps(v)+'\n');out.flush()
for line in sys.stdin:
 try:v=json.loads(line)
 except Exception:continue
 if v.get('type')=='control_request':
  sub=v.get('request',{}).get('subtype')
  rid=v.get('request_id','')
  if sub in ('initialize','interrupt'):
   send({'type':'control_response','response':{'subtype':'success','request_id':rid,'response':{'commands':[{'name':'review','description':'Review code','argumentHint':'<path>'},{'name':'compact','description':'Compact context'}],'models':[{'value':'sonnet','resolvedModel':'claude-sonnet-5','displayName':'Sonnet','description':'Fast model','supportsEffort':True,'supportedEffortLevels':['low','high'],'supportsFastMode':True,'supportsAdaptiveThinking':True,'supportsAutoMode':False}],'agents':[{'name':'Explore','description':'Explore code','model':'inherit'}]}}})
   if sub=='initialize':send({'type':'system','subtype':'init','session_id':'fake-claude-session'})
 elif v.get('type')=='user':
  with open('/tmp/fake-claude-user-log','a') as f:f.write(json.dumps(v)+'\n')
  body=json.dumps(v)
  n=globals().setdefault('turns',0)+1;globals()['turns']=n
  if 'edgeblock' in body and n==1:
   send({'type':'result','subtype':'error','result':'API Error: 403 cloudflare edge blocked the request','isApiErrorMessage':True})
  elif 'rlimit' in body and n==1:
   send({'type':'rate_limit_info','rate_limit_info':{'status':'rejected','rateLimitType':'five_hour','resetsAt':4102444800}})
   send({'type':'result','subtype':'error','result':'Claude usage limit reached','isApiErrorMessage':True})
  elif 'tasklist' in body:
   send({'type':'assistant','message':{'content':[{'type':'tool_use','id':'tu-1','name':'TodoWrite','input':{'todos':[{'content':'write the port','status':'in_progress','activeForm':'writing the port'},{'content':'verify it','status':'pending'}]}}]}})
   send({'type':'assistant','message':{'content':[{'type':'tool_use','id':'tu-2','name':'TaskCreate','input':{'subject':'implement parser','description':'recursive descent'}}]}})
   send({'type':'user','message':{'content':[{'type':'tool_result','tool_use_id':'tu-2','content':json.dumps({'task':{'taskId':'1','subject':'implement parser'}})}]}})
   send({'type':'assistant','message':{'content':[{'type':'text','text':'claude done'}]}})
   send({'type':'result','subtype':'success','result':'done'})
  elif 'subagentdemo' in body:
   send({'type':'assistant','message':{'content':[{'type':'tool_use','id':'tu-task','name':'Task','input':{'prompt':'explore the codebase','subagent_type':'Explore'}}]}})
   send({'type':'system','subtype':'task_progress','task_id':'task-1','tool_use_id':'tu-task','description':'Explore: codebase','last_tool_name':'Read','usage':{'totalTokens':1200}})
   send({'type':'system','subtype':'task_progress','task_id':'task-1','tool_use_id':'tu-unknown','description':'must be dropped'})
   send({'type':'system','subtype':'task_notification','task_id':'task-1','tool_use_id':'tu-task','status':'completed','summary':'found 12 files'})
   send({'type':'assistant','message':{'content':[{'type':'text','text':'subagent done'}]}})
   send({'type':'result','subtype':'success','result':'done'})
  elif 'workflowdemo' in body:
   send({'type':'assistant','message':{'content':[{'type':'tool_use','id':'tu-wf','name':'Workflow','input':{'script':'export const meta={name:"demo"}'}}]}})
   launch={'taskType':'local_workflow','taskId':'wf-task-1','runId':'wf_gate123','scriptPath':'/tmp/gate-wf.js','transcriptDir':'/tmp/gate-wf-transcripts'}
   send({'type':'user','message':{'content':[{'type':'tool_result','tool_use_id':'tu-wf','content':json.dumps(launch)}]}})
   send({'type':'assistant','message':{'content':[{'type':'text','text':'workflow launched'}]}})
   send({'type':'result','subtype':'success','result':'done'})
  else:
   send({'type':'assistant','message':{'content':[{'type':'text','text':'claude done'}]}})
   send({'type':'result','subtype':'success','result':'done'})

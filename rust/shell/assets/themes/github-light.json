      "punctuation.special": {
        "color": "#D73A49"
      },
      "string": {
        "color": "#032F62"
      },
      "string.escape": {
        "color": "#005CC5"
      },
      "string.regex": {
        "color": "#032F62"
      },
      "string.special": {
        "color": "#032F62"
      },
      "string.special.symbol": {
        "color": "#005CC5"

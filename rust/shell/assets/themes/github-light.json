{
  "name": "GitHub Light",
  "appearance": "light",
  "style": {
    "editor.foreground": "#24292E",
    "syntax": {
      "attribute": {
        "color": "#6F42C1"
      },
      "boolean": {
        "color": "#005CC5"
      },
      "comment": {
        "color": "#6A737D"
      },
      "comment.doc": {
        "color": "#6A737D"
      },
      "constant": {
        "color": "#005CC5"
      },
      "constructor": {
        "color": "#6F42C1"
      },
      "embedded": {

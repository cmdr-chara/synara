#!/usr/bin/env python3
import sys,json,time
out=sys.stdout
def send(v):
 out.write(json.dumps(v)+'\n');out.flush()
waiting=False
for line in sys.stdin:
 try:v=json.loads(line)
 except Exception:continue
 if v.get('type')=='control_request':
  sub=v.get('request',{}).get('subtype')
  rid=v.get('request_id','')
  if sub in ('initialize','interrupt'):
   send({'type':'control_response','response':{'subtype':'success','request_id':rid,'response':{}}})
   if sub=='initialize':send({'type':'system','subtype':'init','session_id':'fake-claude-session'})
 elif v.get('type')=='user':
  send({'type':'control_request','request_id':'ask-1','request':{'subtype':'can_use_tool','tool_name':'AskUserQuestion','input':{'questions':[{'header':'Pick','question':'Which option?','options':[{'label':'Visible','description':'desc'}],'multiSelect':False}]}}})
 elif v.get('type')=='control_response':
  if v.get('response',{}).get('request_id')=='ask-1':
   with open('/tmp/fake-claude-ask-log','w') as f:f.write(json.dumps(v.get('response',{}).get('response',{})))
   send({'type':'assistant','message':{'content':[{'type':'text','text':'ask answered'}]}})
   send({'type':'result','subtype':'success','result':'done'})
